# Auto detect text files and perform LF normalization
* text=auto

# Windows scripts must keep CRLF line endings (the launcher breaks with LF only)
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# The end-user guide is plain text with CRLF (and a UTF-8 BOM): keep it on every checkout
README.txt text eol=crlf
